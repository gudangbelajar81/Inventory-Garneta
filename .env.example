# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000

# Database — utamakan DB_URL (format mysql://user:password@host:port/nama_db)
DB_URL=mysql://root:@localhost:3306/retail_inventory

# Fallback jika DB_URL kosong
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=retail_inventory

# Pool koneksi (opsional)
DB_POOL_LIMIT=10
DB_POOL_MAX_IDLE=10
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_SSL=false

# Kompatibilitas Railway MySQL
MYSQLHOST=
MYSQLPORT=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=

# Cron Job (scripts/run-cron.js)
CRON_ENABLED=true
LOW_STOCK_CRON=0 8 * * *
